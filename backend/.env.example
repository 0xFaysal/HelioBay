NODE_ENV=development
APP_MODE=hosted
PORT=4000
DATABASE_URL=postgresql://heliobay:local_dev_only@localhost:5433/heliobay
CORS_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local-only: FIREBASE_AUTH_EMULATOR_HOST=firebase-emulator:9099
# Use workload identity in production, or a protected server-only credential file:
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
ALLOW_DEMO_SEED=false
DEMO_ADMIN_FIREBASE_UID=demo-admin-not-a-real-login
DEMO_OWNER_FIREBASE_UID=demo-owner-not-a-real-login

# SSLCOMMERZ Sandbox: leave both credentials empty to keep payment initiation disabled.
PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
MAX_TOPUP_CREDITS=10000
PAYMENT_TTL_MINUTES=30
PAYMENT_GATEWAY_TIMEOUT_MS=10000

# MQTT / charging. Blank URL keeps the gateway disabled; REST start returns 503.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=heliobay-backend
MQTT_TLS_ENABLED=true
# MQTT_CA_FILE=/secure/path/broker-ca.pem
DEVICE_OFFLINE_TIMEOUT_SECONDS=30
COMMAND_ACK_TIMEOUT_SECONDS=10
TELEMETRY_INTERVAL_MS=1000
TELEMETRY_SAMPLE_INTERVAL_MS=5000
TELEMETRY_RETENTION_DAYS=30
MAX_SESSION_DURATION_SECONDS=14400
MAX_SESSION_ENERGY_MWH=100000000000

# Explicit development-only simulator; never configure these in production.
ALLOW_DEVICE_SIMULATOR=false
SIMULATOR_HMAC_KEY=
SIMULATOR_USERNAME=
SIMULATOR_PASSWORD=
SIMULATOR_STATION=ST001
SIMULATOR_DEVICE=ESP32-ST001
SIMULATOR_BAY=BAY01
SIMULATOR_SPEED=1
SIMULATOR_SCENARIO=normal
