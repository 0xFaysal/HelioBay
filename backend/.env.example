NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://heliobay:local_dev_only@localhost:5433/heliobay
CORS_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Use workload identity in production, or a protected server-only credential file:
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
ALLOW_DEMO_SEED=false
DEMO_ADMIN_FIREBASE_UID=demo-admin-not-a-real-login
DEMO_OWNER_FIREBASE_UID=demo-owner-not-a-real-login

# SSLCOMMERZ Sandbox: leave both credentials empty to keep payment initiation disabled.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
MAX_TOPUP_CREDITS=10000
PAYMENT_TTL_MINUTES=30
PAYMENT_GATEWAY_TIMEOUT_MS=10000
