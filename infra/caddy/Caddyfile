{
  auto_https off
  admin off
}

:8080 {
  encode zstd gzip

  @backend path /api/* /socket.io/* /health/*
  handle @backend {
    reverse_proxy backend:4000
  }

  handle {
    reverse_proxy frontend:3000
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
}
